rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() { return request.auth != null && request.auth.token.admin == true; }
  function validAbout() {
   let d=request.resource.data;
   return d.keys().hasAll(['name','role','description','contact','version','updatedBy','updatedAt'])
    && d.keys().hasOnly(['name','role','description','contact','version','updatedBy','updatedAt'])
    && d.name is string && d.name.size()>0 && d.name.size()<=120
    && d.role is string && d.role.size()>0 && d.role.size()<=150
    && d.description is string && d.description.size()>0 && d.description.size()<=1000
    && d.contact is string && d.contact.size()>0 && d.contact.size()<=250
    && d.version is int && d.version>0
    && d.updatedBy==request.auth.uid && d.updatedAt==request.time;
  }
  function validDocument() {
   let d=request.resource.data;
   return d.keys().hasAll(['title','category','url','description','status','version','updatedBy','updatedAt'])
    && d.keys().hasOnly(['title','category','url','description','status','version','updatedBy','updatedAt'])
    && d.title is string && d.title.size()>0 && d.title.size()<=180
    && d.category is string && d.category.size()>0 && d.category.size()<=100
    && d.url is string && d.url.size()<=1500 && d.url.matches('https://.+')
    && d.description is string && d.description.size()>0 && d.description.size()<=2000
    && d.status in ['draft','published','trashed']
    && d.version is int && d.version>0
    && d.updatedBy==request.auth.uid && d.updatedAt==request.time;
  }
  match /publicContent/{pageId} {
   allow get: if pageId=='about';
   allow list,delete: if false;
   allow create: if pageId=='about' && admin() && validAbout() && request.resource.data.version==1;
   allow update: if pageId=='about' && admin() && validAbout() && resource.data.version is int && request.resource.data.version==resource.data.version+1;
  }
  match /managedDocuments/{documentId} {
   allow get,list: if admin() || resource.data.status=='published';
   allow create: if admin() && validDocument() && request.resource.data.version==1;
   allow update: if admin() && validDocument() && resource.data.version is int && request.resource.data.version==resource.data.version+1;
   allow delete: if admin() && resource.data.status=='trashed';
  }
  match /{document=**} { allow read,write: if false; }
 }
}
